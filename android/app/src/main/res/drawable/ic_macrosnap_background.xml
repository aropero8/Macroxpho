<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo: degradado radial sobre el azul oscuro de la app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Azul oscuro de la app, algo más claro arriba -->
    <path
        android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="30"
                android:gradientRadius="96">
                <item android:offset="0" android:color="#FF1E2A4A" />
                <item android:offset="1" android:color="#FF0B1120" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
