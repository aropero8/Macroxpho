<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo: degradado radial sobre la tinta oscura de la app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Tinta oscura de la app con un punto violeta, algo más clara arriba -->
    <path
        android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="30"
                android:gradientRadius="96">
                <item android:offset="0" android:color="#FF221E33" />
                <item android:offset="1" android:color="#FF0D0C12" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
