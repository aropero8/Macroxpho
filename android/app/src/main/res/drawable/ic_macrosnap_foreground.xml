<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono de MacroSnap: el anillo de proteína casi cerrado (violeta, como el acento de la app)
  con el centro dorado de "objetivo conseguido". Es el mismo dibujo que el logo de la
  cabecera (Logo en src/components/Icon.jsx), escalado.
  Lienzo de 108x108 de los iconos adaptativos; el dibujo cabe en la zona segura central
  (círculo de 66 de diámetro), así que no se recorta con ninguna forma de icono.
  También es el icono de la pantalla de inicio (splash.xml y styles.xml).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Halo violeta detrás del anillo -->
    <path
        android:pathData="M14,54A40,40 0 1,1 94,54A40,40 0 1,1 14,54Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40">
                <item android:offset="0" android:color="#408B7BFF" />
                <item android:offset="0.6" android:color="#1F8B7BFF" />
                <item android:offset="1" android:color="#008B7BFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Anillo: 300 grados en el sentido de las agujas del reloj desde arriba; el hueco
         queda arriba a la izquierda -->
    <path
        android:pathData="M54,29.2A24.8,24.8 0 1,1 32.52,41.6"
        android:strokeWidth="10.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="84">
                <item android:offset="0" android:color="#FFAEA3FF" />
                <item android:offset="1" android:color="#FF6A55F0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Centro dorado -->
    <path
        android:pathData="M45.3,54A8.7,8.7 0 1,1 62.7,54A8.7,8.7 0 1,1 45.3,54Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="45.3"
                android:endX="54"
                android:endY="62.7">
                <item android:offset="0" android:color="#FFFDE68A" />
                <item android:offset="1" android:color="#FFF59E0B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
