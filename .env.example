# Opcional: solo para desarrollo local.
# Lo normal es pegar la API key dentro de la app (Ajustes), así no queda en el bundle.
# Cualquier variable VITE_* se incrusta en el JS final: no la uses en builds que vayas a distribuir.
VITE_GEMINI_API_KEY=

# Modelo por defecto (se puede cambiar también desde Ajustes en la app).
# Tiene que ser uno de los gratuitos de src/lib/models.js; si no, se usa gemini-3.5-flash.
VITE_GEMINI_MODEL=gemini-3.5-flash
